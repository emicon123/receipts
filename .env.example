# Copy this file to .env and fill in real values. Never commit .env itself.
#   cp .env.example .env
#
# Consumed by infra/compose.yml (docker compose --env-file .env ...). Not consumed by
# infra/classify/classify-receipts.sh directly — that script takes its own env vars
# (API_BASE, CLAUDE_BIN, BACKEND_PORT) with hardcoded fallbacks matching the defaults
# below; see infra/classify/README.md for how the two stay in sync.

# ── Database ────────────────────────────────────────────────────
POSTGRES_DB=receipts
POSTGRES_USER=receipts
POSTGRES_PASSWORD=changeme

# ── Spring Boot (passed to the backend container) ────────────────
SPRING_PROFILES_ACTIVE=prod
RECEIPTS_STORAGE_PATH=/data/receipts

# ── Ports ──────────────────────────────────────────────────────────
# Published to 127.0.0.1 only (see infra/compose.yml) — infra/classify/classify-receipts.sh
# runs on this same host and calls the backend directly at http://localhost:${BACKEND_PORT}/api,
# bypassing nginx. Not reachable from the tailnet. If you change this from the default 8080,
# either export BACKEND_PORT before running classify-receipts.sh by hand/via cron, or edit its
# crontab entries to set it inline (cron does not source this file) — see infra/classify/README.md.
BACKEND_PORT=8080

# The app's actual Tailscale-reachable port. investing-app already publishes host port 80 on
# this Pi (see its own infra/compose.yml), so receipts uses a different one by default.
NGINX_PORT=8090

# ── No ANTHROPIC_API_KEY ──────────────────────────────────────────
# Classification rides on the Claude Code CLI's existing Pro/Max subscription login on this
# host (infra/classify/) — there is no Anthropic API key or per-token billing to configure
# anywhere in this app (ADR-002).
